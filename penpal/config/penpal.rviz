Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MotionPlanning1
        - /TF1
        - /TF1/Frames1
        - /Marker - WB1
        - /Pose1
        - /Marker - WB writespace1
        - /Marker - WB writespace1/Topic1
        - /Pose2
      Splitter Ratio: 0.5
    Tree Height: 379
  - Class: rviz_common/Help
    Name: Help
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
